rules_version = '2';

// Reglas TEMPORALES solo para cargar el catálogo. Permiten escribir películas
// a cualquier usuario con sesión. Se publican justo antes de la carga y, al
// terminar, se vuelven a publicar las reglas definitivas (../../firestore.rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /peliculas/{peliculaId} {
      allow read, write: if request.auth != null;
    }
  }
}
