# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# El archivo .env está en .gitignore: NUNCA se sube al repositorio.

# Clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Si la dejas vacía, el servidor funciona en modo REGLAS (sin IA ni internet).
GEMINI_API_KEY=

# Opcionales
PORT=3000
GEMINI_MODEL=gemini-3.5-flash-lite
